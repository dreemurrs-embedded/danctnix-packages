# Maintainer: Christian Dürr <contact@christianduerr.com>

pkgname=(catacomb catacomb-meta)
pkgdesc="A Wayland Mobile Compositor"
pkgver=1.7.1
pkgrel=2
arch=("x86_64" "aarch64")
url="https://git.sr.ht/~undeadleech/catacomb"
license=("GPL-3.0-only")
makedepends=("git" "rust" "cargo" "wayland")
depends=("libxkbcommon" "libinput" "seatd" "mesa")
source=(
    "git+$url#tag=v$pkgver?signed"
    "catacomb-meta.install"
)
validpgpkeys=(
    "4DAA67A9EA8B91FCC15B699C85CDAE3C164BA7B4"  # Christian Dürr <contact@christianduerr.com>
)
sha256sums=(
    "8c4b70e2ac5d8955b10536f9e3a8a71e8e5642a0f6ddeb11165ef7e07be63065"
    "bc9d821a7549d99063e819ee44d27622176a494ed42587c706374b8594264b1a"
)

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname"
  CARGO_INCREMENTAL=0 cargo build --release --locked --offline
}

check() {
  cd "$pkgname"
  CARGO_INCREMENTAL=0 cargo test --locked --offline
}

package_catacomb() {
  optdepends=(
    "iio-sensor-proxy: Accelerometer support"
  )

  cd "$pkgname"

  mkdir -p -m 750 "$pkgdir/usr/share/polkit-1/rules.d"
  install -D -m 644 "rules/66-catacomb.rules.polkit" \
      "$pkgdir/usr/share/polkit-1/rules.d/66-catacomb.rules"

  install -D -m 755 {target/release/$pkgname,session/$pkgname-session} -t $pkgdir/usr/bin/
  install -D -m 644 session/$pkgname{.service,-shutdown.target} -t $pkgdir/usr/lib/systemd/user/
  install -D -m 644 session/$pkgname.desktop -t $pkgdir/usr/share/wayland-sessions/
}

package_catacomb-meta() {
  depends=("catacomb" "epitaph" "wvkbd" "swayidle" "tinydm" "tremor" "tzompantli" "grim" "slurp")
  optdepends=(
      "alacritty: terminal emulator"
      #"kumo: web browser" - Currently only distributed by the catacomb repository
      "gorm: WiFi GUI"
      "aevum: alarm clock"
      #"charon: maps & navigation" - Currently only distributed by the catacomb repository
      "pinax: notepad"
      "tabula: wallpaper"
  )
  backup=("etc/catacomb/initrc")
  install=$pkgname.install

  cd "catacomb"
  install -Dm755 "initrc" "$pkgdir/etc/catacomb/initrc"
}
