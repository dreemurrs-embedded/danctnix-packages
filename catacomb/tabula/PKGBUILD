# Maintainer: Christian Dürr <contact@christianduerr.com>

pkgname=tabula
pkgdesc="Wayland Wallpaper Tool"
pkgver=1.0.2
pkgrel=2
arch=("x86_64" "aarch64")
url="https://git.sr.ht/~undeadleech/tabula"
license=("GPL-3.0-only")
makedepends=("git" "rust" "cargo")
depends=("libxkbcommon" "mesa")
source=("git+$url#tag=v$pkgver?signed")
validpgpkeys=(
    "4DAA67A9EA8B91FCC15B699C85CDAE3C164BA7B4"  # Christian Dürr <contact@christianduerr.com>
)
sha256sums=("09a58d31781d7dc8b953a4bde638be459f9e27870a2b6fc5ebb8908406bf2e8a")

prepare() {
  cd "$pkgname"

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname"

  CARGO_INCREMENTAL=0 cargo build --release --locked --offline
}

check() {
  cd "$pkgname"

  CARGO_INCREMENTAL=0 cargo test --locked --offline
}

package() {
  install -D -m 755 "$pkgname/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
}
