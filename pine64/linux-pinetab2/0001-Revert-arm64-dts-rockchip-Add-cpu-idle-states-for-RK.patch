From dd8b6bbed3a194346c16646fca7cd48943614975 Mon Sep 17 00:00:00 2001
From: Danct12 <danct12@disroot.org>
Date: Sat, 21 Nov 2026 17:49:26 +0000
Subject: [PATCH] Revert "arm64: dts: rockchip: Add cpu-idle-states for RK356x"

This reverts commit 8815150fd026cba9f9b2536cfae5011079522801.
---
 arch/arm64/boot/dts/rockchip/rk356x-base.dtsi | 16 ----------------
 1 file changed, 16 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi b/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi
index 1ee2e5e4c226..43aefb4dc5e5 100644
--- a/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk356x-base.dtsi
@@ -56,7 +56,6 @@ cpu0: cpu@0 {
 			reg = <0x0 0x0>;
 			clocks = <&scmi_clk SCMI_CLK_CPU>;
 			#cooling-cells = <2>;
-			cpu-idle-states = <&CPU_SLEEP>;
 			enable-method = "psci";
 			i-cache-size = <0x8000>;
 			i-cache-line-size = <64>;
@@ -73,7 +72,6 @@ cpu1: cpu@100 {
 			reg = <0x0 0x100>;
 			clocks = <&scmi_clk SCMI_CLK_CPU>;
 			#cooling-cells = <2>;
-			cpu-idle-states = <&CPU_SLEEP>;
 			enable-method = "psci";
 			i-cache-size = <0x8000>;
 			i-cache-line-size = <64>;
@@ -90,7 +88,6 @@ cpu2: cpu@200 {
 			reg = <0x0 0x200>;
 			clocks = <&scmi_clk SCMI_CLK_CPU>;
 			#cooling-cells = <2>;
-			cpu-idle-states = <&CPU_SLEEP>;
 			enable-method = "psci";
 			i-cache-size = <0x8000>;
 			i-cache-line-size = <64>;
@@ -107,7 +104,6 @@ cpu3: cpu@300 {
 			reg = <0x0 0x300>;
 			clocks = <&scmi_clk SCMI_CLK_CPU>;
 			#cooling-cells = <2>;
-			cpu-idle-states = <&CPU_SLEEP>;
 			enable-method = "psci";
 			i-cache-size = <0x8000>;
 			i-cache-line-size = <64>;
@@ -117,18 +113,6 @@ cpu3: cpu@300 {
 			d-cache-sets = <128>;
 			next-level-cache = <&l3_cache>;
 		};
-
-		idle-states {
-			entry-method = "psci";
-			CPU_SLEEP: cpu-sleep {
-				compatible = "arm,idle-state";
-				arm,psci-suspend-param = <0x0010000>;
-				entry-latency-us = <100>;
-				exit-latency-us = <120>;
-				local-timer-stop;
-				min-residency-us = <1000>;
-			};
-		};
 	};
 
 	/*
-- 
2.56.1

