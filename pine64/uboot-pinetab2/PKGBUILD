buildarch=8

pkgname=uboot-pinetab2
pkgver=2026.10.danctnix2
pkgrel=1
pkgdesc="U-Boot for PineTab 2"
_srcname=u-boot
_srctag=v${pkgver%.*}-${pkgver##*.}
arch=('aarch64')
_url_git="https://codeberg.org/DanctNIX/${_srcname}"
url="${_url_git}/commits/tag/$_srctag"
license=(GPL-2.0-only)
depends=('mtd-utils' 'uboot-tools')
makedepends=('bc' 'git' 'python' 'python-pyelftools' 'python-setuptools' 'swig')
replaces=(uboot-pinetab2-mainline)
install=${pkgname}.install
backup=("boot/boot.txt")

_uboot_upstream_url="https://git.u-boot-project.org/u-boot/u-boot"

_commit_rkbin="3e288fe814e059dd06833495f845cab04ac20a5c"
source=(${_uboot_upstream_url}/-/releases/v${pkgver%.*}/downloads/u-boot-${pkgver%.*}.tar.bz2{,.sig}
        ${_url_git}/releases/download/${_srctag}/${_srctag}.patch.zst{,.sig}
        "rkbin::git+https://github.com/rockchip-linux/rkbin.git#commit=$_commit_rkbin"
        'bl31.elf'
        'boot.txt'
        'mkscr'
        'update-u-boot')
