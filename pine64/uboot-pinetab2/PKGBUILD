prepare() {
  cd u-boot-v${pkgver%.*}

  local src
  for src in "${source[@]}"; do
      src="${src%%::*}"
      src="${src##*/}"
      src="${src%.zst}"
      [[ $src = *.patch ]] || continue
      echo "Applying patch: $src..."
      patch -Np1 < "../$src"
  done
}

build() {
  cd u-boot-v${pkgver%.*}

  make pinetab2-rk3566_defconfig

  make \
    BL31=${srcdir}/bl31.elf \
    ROCKCHIP_TPL=../rkbin/bin/rk35/rk3566_ddr_1056MHz_v1.26.bin
}

package() {
  cd u-boot-v${pkgver%.*}

  mkdir -p "${pkgdir}/boot"

  cp ./idbloader.img "${pkgdir}/boot/idbloader.img"
  cp ./u-boot.itb "${pkgdir}/boot/u-boot.itb"
  cp ./u-boot-rockchip-spi.bin "${pkgdir}/boot/u-boot-rockchip-spi.bin"

  cp ../{boot.txt,mkscr} "${pkgdir}"/boot
  mkdir -p "${pkgdir}"/usr/bin && cp ../update-u-boot "${pkgdir}"/usr/bin
}
