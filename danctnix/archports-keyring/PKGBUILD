pkgver() {
    date +%Y%m%d
}

package() {
    local destdir=usr/share/pacman/keyrings

    install -d $pkgdir/$destdir

    install -Dm644 archports-drzee.gpg $pkgdir/$destdir/

    install -Dm644 archports{-trusted,-revoked} $pkgdir/$destdir/
}
